#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D source_image;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D target_image;

layout(push_constant) uniform BlurData {
  ivec2 direction;
  int radius;
  int source_scale;
} data;

void main() {
  ivec2 target_pos = ivec2(gl_GlobalInvocationID.xy);
  ivec2 target_size = imageSize(target_image);
  if (any(greaterThanEqual(target_pos, target_size)))
    return;

  ivec2 source_size = textureSize(source_image, 0);
  vec2 center = (vec2(target_pos) + vec2(0.5)) / vec2(target_size);
  float sigma = max(float(data.radius) * 0.5, 0.5);
  vec4 sum = vec4(0.0);
  float weight_sum = 0.0;
  for (int offset = -32; offset <= 32; ++offset) {
    if (abs(offset) > data.radius)
      continue;
    float weight = exp(-float(offset * offset) / (2.0 * sigma * sigma));
    vec2 sample_pos = clamp(center + vec2(data.direction * offset) /
                                      vec2(source_size),
                            vec2(0.0), vec2(1.0));
    sum += textureLod(source_image, sample_pos, 0.0) * weight;
    weight_sum += weight;
  }
  imageStore(target_image, target_pos, sum / max(weight_sum, 0.00001));
}
